# =============================================================================
# Muninn - environment configuration example
#
# Copy to .env and fill in. NEVER commit a real .env (it is gitignored).
# Muninn is a fork of Linkwarden; the full upstream variable surface still
# works. The variables below are the ones a typical self-hosted Muninn needs,
# grouped, with the Muninn-specific additions marked [MUNINN].
# =============================================================================

# --- Core (required) --------------------------------------------------------
# Public base URL + the auth path. Must match how the app is reached.
NEXTAUTH_URL=http://localhost:3000/api/v1/auth
# Random 32+ byte secret used to sign sessions/JWTs. Generate: openssl rand -base64 32
NEXTAUTH_SECRET=

# PostgreSQL connection string (Prisma). When using the bundled compose,
# POSTGRES_PASSWORD is enough and DATABASE_URL is set for you.
DATABASE_URL=postgresql://postgres:password@postgres:5432/postgres
POSTGRES_PASSWORD=

# --- Search (optional but recommended) --------------------------------------
# Meilisearch powers full-text search over links. Omit to disable search.
MEILI_HOST=http://meilisearch:7700
MEILI_MASTER_KEY=

# --- Registration & admin ---------------------------------------------------
# Close public self-registration. With this "true", anonymous signups are
# blocked but an authenticated admin can STILL provision users (Muninn fixes
# the upstream #984 coupling where this also broke admin user creation).
NEXT_PUBLIC_DISABLE_REGISTRATION=true
# Bootstrap admin: the numeric user id treated as an instance admin on a fresh
# install (usually 1, the first account). Superseded by the DB isAdmin role.
NEXT_PUBLIC_ADMIN=1
# [MUNINN] Break-glass admin allowlist (comma-separated emails). These are
# always admins, resolved without a DB lookup, so you can never lock yourself
# out. Layer SSO-group -> admin on top of this.
SUPER_ADMIN_EMAILS=

# --- [MUNINN] Audit log -----------------------------------------------------
# HMAC secret for the tamper-evident admin audit chain. Strongly recommended
# in production; without it the chain falls back to plain SHA-256. 32+ bytes.
AUDIT_HMAC_SECRET=

# --- SSO (optional; pick one provider or use local password auth) -----------
# Microsoft Entra ID (Azure AD) OIDC. Redirect URI to register in Entra:
#   <NEXTAUTH_URL origin>/api/v1/auth/callback/azure-ad
NEXT_PUBLIC_AZURE_AD_ENABLED=
AZURE_AD_CLIENT_ID=
AZURE_AD_CLIENT_SECRET=
AZURE_AD_TENANT_ID=

# Generic OIDC (any standards-compliant IdP: Authelia, Authentik, Keycloak...).
# This is the provider-agnostic path; nothing about Muninn is Entra-specific.
NEXT_PUBLIC_OIDC_ENABLED=
OIDC_CUSTOM_NAME=
OIDC_WELLKNOWN_URL=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_SCOPES=openid profile email

# --- Misc -------------------------------------------------------------------
# Read-only demo mode disables all write endpoints. Leave empty for normal use.
NEXT_PUBLIC_DEMO=
# Version string surfaced at /api/v1/health and the UI footer (CI sets this).
MUNINN_VERSION=0.1.0
